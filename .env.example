# === Database ===
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=streamplatform

# === Backend ===
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://root:password@localhost:5432/streamplatform?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=generate_32_char_secret_here
JWT_REFRESH_SECRET=generate_32_char_secret_here
INGEST_HOOK_SECRET=dev_ingest_secret_change_me_32chars
FRONTEND_URL=http://localhost:5173
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === NATS ===
NATS_URL=nats://nats:4222

# === Edge ===
EDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === SRS ===
SRS_HLS_BASE_URL=http://srs:8080
SRS_HLS_PATH=/hls

# === Scylla ===
SCYLLA_CONTACT_POINTS=scylla
SCYLLA_PORT=9042
SCYLLA_DATACENTER=datacenter1
SCYLLA_KEYSPACE=streamplatform

